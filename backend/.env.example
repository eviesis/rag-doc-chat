# Copy this file to .env and fill in your key(s)

# Which provider to use for answer generation: "anthropic" or "groq"
LLM_PROVIDER=groq

# --- Anthropic (used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Groq (used if LLM_PROVIDER=groq) - free tier, get key at console.groq.com ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides (defaults shown)
MAX_TOKENS=2048
LLM_MAX_RETRIES=4
LLM_BASE_BACKOFF_SECONDS=1.0
LLM_MIN_SECONDS_BETWEEN_CALLS=0.5

# Hugging Face embedding model. If you change it, clear and re-upload your documents.
# Stronger option: BAAI/bge-small-en-v1.5 (also set EMBEDDING_QUERY_PREFIX below)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:
EMBEDDING_QUERY_PREFIX=

CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=4

# Vector store backend: chroma | faiss
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=documents
FAISS_INDEX_DIR=./faiss_store

# Optional Hugging Face cross-encoder reranking (downloads ~90MB on first use)
RERANK_ENABLED=false
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVE_CANDIDATES=12

CORS_ORIGINS=http://localhost:5173
