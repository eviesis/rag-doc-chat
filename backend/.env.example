# Copy this file to .env and fill in your key(s)

# Which provider to use for answer generation: "anthropic" or "groq"
LLM_PROVIDER=groq

# --- Anthropic (used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Groq (used if LLM_PROVIDER=groq) - free tier, get key at console.groq.com ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional overrides (defaults shown)
MAX_TOKENS=1024
LLM_MAX_RETRIES=4
LLM_BASE_BACKOFF_SECONDS=1.0
LLM_MIN_SECONDS_BETWEEN_CALLS=0.5

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=4

CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION_NAME=documents

CORS_ORIGINS=http://localhost:5173
